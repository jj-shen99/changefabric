        subgraph S2Approvers["Approvers"]
            A3["👤 User C\n⏳ PENDING"]
            A4["👤 User D\n⏳ PENDING"]
        end
    end

    subgraph Step3["Step 3: CAB Approval (ordering: 3)"]
        direction TB
        S3Policy["Policy: QUORUM:2"]
        S3Status["Status: ⏸️ waiting"]
        subgraph S3Approvers["Approvers"]
            A5["👤 CAB 1\n⏳ PENDING"]
