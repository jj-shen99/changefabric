%%{init: {'theme': 'base', 'themeVariables': { 'primaryColor': '#4F46E5', 'primaryTextColor': '#fff', 'lineColor': '#6366F1'}}}%%
stateDiagram-v2
    [*] --> draft: Create CR

    %% Standard Workflow
    draft --> submitted: submit
    draft --> canceled: cancel

    submitted --> awaiting_approval: request_approval
    submitted --> emergency_approval: request_emergency_approval\n(emergency only)
    submitted --> draft: return_to_draft
    submitted --> canceled: cancel
    submitted --> rejected: reject\n(emergency only)

    %% Emergency Approval (emergency workflow)
    emergency_approval --> in_progress: approve_emergency\n[emergencyApprovalGranted]
    emergency_approval --> rejected: reject

    %% Standard Approval
    awaiting_approval --> approved: approve\n[allApprovalStepsApproved]
    awaiting_approval --> rejected: reject
    awaiting_approval --> canceled: cancel

    approved --> scheduled: schedule\n[hasPlannedWindow]
    approved --> in_progress: implement\n[setActualStart]
    approved --> canceled: cancel

    scheduled --> in_progress: implement\n[setActualStart]
    scheduled --> canceled: cancel

    in_progress --> implemented: complete/implement\n[setActualEnd]
    in_progress --> rolled_back: rollback\n[setRolledBack]

    implemented --> awaiting_approval: request_approval\n(retro approval)
    implemented --> closed: close\n[setClosed]
    implemented --> rolled_back: rollback\n[setRolledBack]

    rolled_back --> [*]
    closed --> [*]
    rejected --> [*]
    canceled --> [*]

    note right of draft: Initial state\n(editable)
    note right of emergency_approval: Emergency approval\n(fast-track)
    note right of awaiting_approval: Approval steps\nmust complete
    note right of approved: Ready for\nscheduling or\nimplementation
    note right of scheduled: Planned window set
    note right of in_progress: Implementation\nin progress\n(no cancel)
    note right of implemented: Change deployed\n(no cancel)
    note left of closed: Terminal state\n(success)
    note left of rejected: Terminal state\n(denied)
    note left of rolled_back: Terminal state\n(reverted)
