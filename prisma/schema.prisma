generator client {
  provider = "prisma-client-js"
}

// ── Database Configuration ────────────────────────────────────
// Set DATABASE_PROVIDER in env to switch between sqlite (dev) and postgresql (prod)
// Example DATABASE_URL:
//   sqlite:     "file:./dev.db"
//   postgresql: "postgresql://user:pass@host:5432/release_change_ai?schema=public"
datasource db {
  // NOTE: provider must be a string literal in Prisma v6+. To swap to
  // postgresql for production, change this line and re-run `prisma db push`.
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ── Auth & Users ──────────────────────────────────────────────

model User {
  id             String   @id @default(uuid())
  email          String   @unique
  name           String
  hashedPassword String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  resetToken       String?   @unique
  resetTokenExpiry DateTime?

  // Many-to-many relationship with roles
  userRoles      UserRole[]
}

// ── Role-Based Access Control ─────────────────────────────────
// Roles define granular permissions. Users can have multiple roles.

model Role {
  id          String   @id @default(uuid())
  name        String   @unique   // e.g., "admin", "change_manager", "approver"
  displayName String              // e.g., "Administrator", "Change Manager"
  description String?
  
  // Permissions (each role can have multiple permissions enabled)
  canManageUsers      Boolean @default(false)
  canManageRoles      Boolean @default(false)
  canManageChanges    Boolean @default(false)
  canApproveChanges   Boolean @default(false)
  canImplementChanges Boolean @default(false)
  canManageReleases   Boolean @default(false)
  canEditSettings     Boolean @default(false)
  canViewMetrics      Boolean @default(false)
  canViewAllData      Boolean @default(false)
  
  isSystem    Boolean  @default(false)  // System roles cannot be deleted
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userRoles   UserRole[]
}

// Junction table for User-Role many-to-many relationship
model UserRole {
  id        String   @id @default(uuid())
  userId    String
  roleId    String
  assignedBy String?              // Email of admin/manager who assigned the role
  assignedAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
}

// ── Generic Change Management Domain ─────────────────────────
// Re-architected: framework-agnostic change-request schema, inspired by the
// ServiceNow change_request table but free of any vendor coupling. The
// ServiceNow connector (under src/lib/integrations/servicenow) is now an
// optional plugin; the core schema below stands on its own.

model ChangeRequest {
  // Identity
  number          String   @id                       // e.g. CHG0001234, generated locally
  externalId      String?  @unique                   // optional foreign system id (e.g. ServiceNow sys_id)
  externalSource  String?                            // "servicenow" | "jira" | null
  workflowKey     String   @default("standard")      // FK-by-key to WorkflowDefinition.key

  // Core descriptive fields (generic — superset of typical ITSM CR)
  title           String
  description     String   @default("")
  type            String   @default("standard")      // standard | emergency | pre-approved
  category        String   @default("other")
  priority        String   @default("3")             // 1..4
  riskLevel       String   @default("moderate")      // low | moderate | high | very_high
  impactLevel     String   @default("3")             // 1..3
  urgency         String   @default("3")             // 1..3
  state           String   @default("draft")         // workflow state key (see WorkflowDefinition)
  approvalState   String   @default("not_requested") // not_requested | pending | approved | rejected

  // Plans & narrative
  justification         String @default("")
  implementationPlan    String @default("")
  backoutPlan           String @default("")
  testPlan              String @default("")
  riskAndImpactAnalysis String @default("")
  closeCode             String @default("")
  closeNotes            String @default("")

  // Scheduling
  plannedStart    DateTime?
  plannedEnd      DateTime?
  actualStart     DateTime?
  actualEnd       DateTime?

  // People & ownership
  requestedBy     String                        // user email
  assignedTo      String?                       // user email
  assignmentGroup String?

  // CI / business context
  configurationItem String?
  businessService   String?
  affectedServices  String  @default("[]")      // JSON array<string>
  tags              String  @default("[]")      // JSON array<string>

  // Risk scoring (computed; cached for fast queries)
  computedRiskScore Float   @default(0)
  computedImpactScore Float @default(0)
  mlRiskScore        Float? 
  mlConfidence       Float?
  mlExplanation      String? @default("")

  // Bookkeeping
  releaseId        String?
  release          Release? @relation(fields: [releaseId], references: [id])
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  createdBy        String                       // user email
  closedAt         DateTime?
  closedBy         String?

  // Relations
  validations     Validation[]
  approvals       Approval[]
  approvalSteps   ApprovalStep[]
  comments        Comment[]
  attachments     Attachment[]
  auditEvents     AuditEvent[]
  transitions     WorkflowTransitionLog[]

  @@index([state])
  @@index([requestedBy])
  @@index([assignedTo])
  @@index([releaseId])
  @@index([createdAt])
}

model Validation {
  id              String   @id @default(uuid())
  changeRequestId String
  type            String
  name            String
  status          String   @default("pending")     // pending | running | passed | failed | skipped
  startedAt       DateTime?
  completedAt     DateTime?
  duration        String?
  coverage        Float?
  details         String?
  blockers        String   @default("[]")          // JSON array

  changeRequest ChangeRequest @relation(fields: [changeRequestId], references: [number], onDelete: Cascade)

  @@index([changeRequestId])
}

// ── Workflow Engine ──────────────────────────────────────────
// A WorkflowDefinition is a versioned, declarative state machine. Code-defined
// defaults are seeded into the DB so admins can override per-tenant.

model WorkflowDefinition {
  key         String  @id                    // e.g. "standard", "emergency"
  name        String
  description String  @default("")
  version     Int     @default(1)
  // JSON-encoded { initial: string, states: Record<state, StateDef>, transitions: TransitionDef[] }
  definition  String
  isDefault   Boolean @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model WorkflowTransitionLog {
  id              String   @id @default(uuid())
  changeRequestId String
  fromState       String
  toState         String
  event           String                     // transition event name
  actor           String                     // user email
  reason          String?                    // optional comment
  createdAt       DateTime @default(now())

  changeRequest ChangeRequest @relation(fields: [changeRequestId], references: [number], onDelete: Cascade)

  @@index([changeRequestId])
}

// ── Multi-Person Approvals ───────────────────────────────────
// An ApprovalStep is one logical gate (e.g. "Tech Lead", "CAB"). It has a
// policy ("all" / "any" / "quorum:N") and one or more Approval rows for the
// individuals/groups required to vote.

model ApprovalStep {
  id              String   @id @default(uuid())
  changeRequestId String
  name            String                     // "Tech Review", "CAB", "Security"
  ordering        Int      @default(0)       // sequential order; same value => parallel
  policy          String   @default("all")   // "all" | "any" | "quorum:N"
  status          String   @default("pending") // pending | approved | rejected | skipped
  startedAt       DateTime?
  completedAt     DateTime?

  changeRequest ChangeRequest @relation(fields: [changeRequestId], references: [number], onDelete: Cascade)
  approvals     Approval[]

  @@index([changeRequestId])
}

model Approval {
  id              String   @id @default(uuid())
  changeRequestId String
  stepId          String?
  approverEmail   String                     // individual approver
  approverGroup   String?                    // optional group label
  decision        String   @default("pending") // pending | approved | rejected | delegated
  comment         String?
  delegatedTo     String?
  decidedAt       DateTime?
  createdAt       DateTime @default(now())

  changeRequest ChangeRequest @relation(fields: [changeRequestId], references: [number], onDelete: Cascade)
  step          ApprovalStep? @relation(fields: [stepId], references: [id], onDelete: Cascade)

  @@index([changeRequestId])
  @@index([approverEmail])
}

// ── Collaboration ────────────────────────────────────────────

model Comment {
  id              String   @id @default(uuid())
  changeRequestId String
  authorEmail     String
  body            String
  visibility      String   @default("public") // public | internal
  createdAt       DateTime @default(now())

  changeRequest ChangeRequest @relation(fields: [changeRequestId], references: [number], onDelete: Cascade)

  @@index([changeRequestId])
}

model Attachment {
  id              String   @id @default(uuid())
  changeRequestId String
  filename        String
  mimeType        String
  size            Int
  url             String                     // presigned/local path
  uploadedBy      String
  uploadedAt      DateTime @default(now())

  changeRequest ChangeRequest @relation(fields: [changeRequestId], references: [number], onDelete: Cascade)

  @@index([changeRequestId])
}

// ── Audit & Notifications ────────────────────────────────────

model AuditEvent {
  id              String   @id @default(uuid())
  changeRequestId String?
  actor           String                     // user email or "system"
  action          String                     // e.g. "cr.create", "cr.transition", "approval.decide"
  // JSON-encoded payload describing the event
  payload         String   @default("{}")
  createdAt       DateTime @default(now())

  changeRequest ChangeRequest? @relation(fields: [changeRequestId], references: [number], onDelete: SetNull)

  @@index([changeRequestId])
  @@index([action])
  @@index([createdAt])
}

model Notification {
  id          String   @id @default(uuid())
  recipient   String                          // user email
  subject     String
  body        String
  link        String?
  read        Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([recipient])
  @@index([read])
}

model Release {
  id              String   @id
  name            String
  version         String
  status          String   @default("planning")
  scheduledDate   DateTime
  actualDate      DateTime?
  overallRisk     Int      @default(0)
  releaseManager  String
  notes           String?

  changeRequests  ChangeRequest[]
}

model DashboardMetric {
  id                 String   @id @default(uuid())
  totalChanges       Int      @default(0)
  pendingChanges     Int      @default(0)
  deployedToday      Int      @default(0)
  failedDeployments  Int      @default(0)
  avgRiskScore       Float    @default(0)
  validationPassRate Float    @default(0)
  avgDeployTime      String   @default("0m")
  rollbackRate       Float    @default(0)
  mttr               String   @default("0m")
  changeLeadTime     String   @default("0 days")
  recordedAt         DateTime @default(now())
}

// ── Integration Settings ─────────────────────────────────────────
// Stores encrypted credentials for ServiceNow and Git integrations

model IntegrationSetting {
  id        String   @id @default(uuid())
  userId    String   // User email who saved this credential
  type      String   // "snow" or "git"
  key       String   // "instance", "user", "password"
  value     String   // encrypted value
  encrypted Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, type, key])
}

// ── Saved Analysis Results ───────────────────────────────────────
// Stores analysis results for change requests (Plan Analysis, ML Analysis, Code Change Analysis)

model SavedAnalysis {
  id              String   @id @default(uuid())
  name            String   // User-provided name for this analysis
  description     String?  // Optional description
  analysisType    String   // "plan" | "ml" | "code" | "combined"
  changeRequestId String?  // Associated CR number (optional)
  repoUrl         String?  // For code analysis
  analysisDate    DateTime @default(now())
  
  // Scores
  overallScore    Float?
  planReadyScore  Float?
  mlScore         Float?
  codeRiskScore   Float?
  
  // Full analysis data as JSON
  analysisData    String   // JSON blob with full analysis details
  
  // Metadata
  createdBy       String   // User email who created this
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([changeRequestId])
  @@index([analysisType])
  @@index([createdBy])
}

// ── Change Request Templates ────────────────────────────────────
// Reusable templates for creating new change requests with pre-filled values

model ChangeRequestTemplate {
  id              String   @id @default(uuid())
  name            String   @unique                // e.g. "Database Migration", "Feature Flag Rollout"
  description     String   @default("")
  category        String   @default("other")      // infrastructure | feature | hotfix | database | config | security | other
  
  // Pre-filled values
  type            String   @default("standard")   // standard | emergency | pre-approved
  workflowKey     String   @default("standard")   // standard | emergency | standard_preapproved
  priority        String   @default("3")          // 1 | 2 | 3 | 4
  riskLevel       String   @default("moderate")   // low | moderate | high | very_high
  impactLevel     String   @default("3")          // 1 | 2 | 3
  urgency         String   @default("3")          // 1 | 2 | 3
  assignmentGroup String?
  
  // Template plans (placeholders encouraged)
  implementationPlan    String @default("")
  backoutPlan           String @default("")
  testPlan              String @default("")
  riskAndImpactAnalysis String @default("")
  justification         String @default("")
  
  // Suggested approval steps as JSON array
  suggestedApprovalSteps String @default("[]")    // JSON array of step definitions
  
  // Metadata
  isActive        Boolean  @default(true)
  createdBy       String                          // user email
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([category])
  @@index([isActive])
}

// ── Groups ───────────────────────────────────────────────────────
// Groups for organizing users (e.g., "CAB", "Security", "Engineering")
// Used for approver assignments and assignment groups

model Group {
  id          String   @id @default(uuid())
  name        String   @unique                  // e.g., "CAB", "Security Team", "Engineering"
  description String   @default("")
  type        String   @default("approver")     // "approver" | "assignment" | "both"
  isActive    Boolean  @default(true)
  createdBy   String                            // Admin who created this group
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([type])
  @@index([isActive])
}

// ── CR Type Default Approvers ────────────────────────────────────
// Defines default approvers for each type of change request
// When a CR is created, these approvers are automatically added to approval steps

model CRTypeApprover {
  id              String   @id @default(uuid())
  crType          String                          // "standard" | "emergency" | "pre-approved"
  approverEmail   String                          // User email of the approver
  approverGroup   String?                         // Optional group name (e.g., "CAB", "Security")
  stepName        String   @default("Default")    // Approval step name (e.g., "Tech Review", "CAB")
  ordering        Int      @default(1)            // Order of the approval step
  isActive        Boolean  @default(true)
  createdBy       String                          // Admin who created this assignment
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([crType, approverEmail, stepName])
  @@index([crType])
  @@index([approverEmail])
  @@index([isActive])
}

// ── System Settings ──────────────────────────────────────────
// Key-value store for system-wide settings like approval policies

model SystemSetting {
  id        String   @id @default(uuid())
  key       String   @unique  // e.g., "approval_policy_critical", "notification_threshold"
  value     String             // JSON string for complex values
  category  String   @default("general")  // e.g., "approval", "notification", "general"
  updatedBy String?
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@index([category])
}
