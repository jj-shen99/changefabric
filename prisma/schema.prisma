generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ── Auth & Users ──────────────────────────────────────────────

model User {
  id             String   @id @default(uuid())
  email          String   @unique
  name           String
  hashedPassword String
  role           String   @default("viewer") // admin | manager | viewer
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  resetToken       String?   @unique
  resetTokenExpiry DateTime?
}

// ── Domain Models (ServiceNow change_request) ────────────────

model ChangeRequest {
  number              String  @id
  sys_id              String  @unique
  short_description   String  @default("")
  description         String  @default("")
  category            String  @default("")
  state               String  @default("")
  type                String  @default("")
  priority            String  @default("")
  risk                String  @default("")
  impact              String  @default("")
  urgency             String  @default("")
  scope               String  @default("")
  approval            String  @default("")
  assigned_to         String  @default("")
  assignment_group    String  @default("")
  opened_by           String  @default("")
  opened_at           String  @default("")
  closed_at           String  @default("")
  closed_by           String  @default("")
  close_code          String  @default("")
  close_notes         String  @default("")
  start_date          String  @default("")
  end_date            String  @default("")
  work_start          String  @default("")
  work_end            String  @default("")
  expected_start      String  @default("")
  implementation_plan String  @default("")
  backout_plan        String  @default("")
  test_plan           String  @default("")
  change_plan         String  @default("")
  risk_impact_analysis String @default("")
  justification       String  @default("")
  cmdb_ci             String  @default("")
  business_service    String  @default("")
  service_offering    String  @default("")
  company             String  @default("")
  contact_type        String  @default("")
  location            String  @default("")
  requested_by        String  @default("")
  requested_by_date   String  @default("")
  parent              String  @default("")
  reason              String  @default("")
  route_reason        String  @default("")
  conflict_status     String  @default("")
  conflict_last_run   String  @default("")
  cab_required        String  @default("")
  cab_recommendation  String  @default("")
  cab_delegate        String  @default("")
  cab_date_time       String  @default("")
  upon_approval       String  @default("")
  upon_reject         String  @default("")
  approval_set        String  @default("")
  approval_history    String  @default("")
  escalation          String  @default("")
  made_sla            String  @default("")
  sla_due             String  @default("")
  due_date            String  @default("")
  active              String  @default("")
  phase               String  @default("")
  phase_state         String  @default("")
  knowledge           String  @default("")
  order               String  @default("")
  unauthorized        String  @default("")
  on_hold             String  @default("")
  on_hold_reason      String  @default("")
  on_hold_task        String  @default("")
  production_system   String  @default("")
  outside_maintenance_schedule String @default("")
  review_status       String  @default("")
  review_date         String  @default("")
  review_comments     String  @default("")
  follow_up           String  @default("")
  user_input          String  @default("")
  watch_list          String  @default("")
  group_list          String  @default("")
  additional_assignee_list String @default("")
  work_notes          String  @default("")
  work_notes_list     String  @default("")
  comments            String  @default("")
  comments_and_work_notes String @default("")
  correlation_id      String  @default("")
  correlation_display String  @default("")
  copied_from         String  @default("")
  delivery_plan       String  @default("")
  delivery_task       String  @default("")
  contract            String  @default("")
  universal_request   String  @default("")
  std_change_producer_version String @default("")
  chg_model           String  @default("")
  task_effective_number String @default("")
  sys_class_name      String  @default("")
  sys_created_by      String  @default("")
  sys_created_on      String  @default("")
  sys_updated_by      String  @default("")
  sys_updated_on      String  @default("")
  sys_domain          String  @default("")
  sys_domain_path     String  @default("")
  sys_mod_count       String  @default("")
  sys_tags            String  @default("")
  activity_due        String  @default("")
  time_worked         String  @default("")
  reassignment_count  String  @default("")
  business_duration   String  @default("")
  calendar_duration   String  @default("")

  validations Validation[]
}

model Validation {
  id              String   @id
  changeRequestId String
  type            String
  name            String
  status          String   @default("pending")
  startedAt       DateTime?
  completedAt     DateTime?
  duration        String?
  coverage        Float?
  details         String?
  blockers        String   @default("[]") // JSON array

  changeRequest ChangeRequest @relation(fields: [changeRequestId], references: [number], onDelete: Cascade)
}

model Release {
  id              String   @id
  name            String
  version         String
  status          String   @default("planning")
  scheduledDate   DateTime
  actualDate      DateTime?
  overallRisk     Int      @default(0)
  releaseManager  String
  notes           String?
}

model DashboardMetric {
  id                 String   @id @default(uuid())
  totalChanges       Int      @default(0)
  pendingChanges     Int      @default(0)
  deployedToday      Int      @default(0)
  failedDeployments  Int      @default(0)
  avgRiskScore       Float    @default(0)
  validationPassRate Float    @default(0)
  avgDeployTime      String   @default("0m")
  rollbackRate       Float    @default(0)
  mttr               String   @default("0m")
  changeLeadTime     String   @default("0 days")
  recordedAt         DateTime @default(now())
}

// ── Integration Settings ─────────────────────────────────────────
// Stores encrypted credentials for ServiceNow and Git integrations

model IntegrationSetting {
  id        String   @id @default(uuid())
  type      String   // "snow" or "git"
  key       String   // "instance", "user", "password"
  value     String   // encrypted value
  encrypted Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([type, key])
}

// ── Saved Analysis Results ───────────────────────────────────────
// Stores analysis results for change requests (Plan Analysis, ML Analysis, Code Change Analysis)

model SavedAnalysis {
  id              String   @id @default(uuid())
  name            String   // User-provided name for this analysis
  description     String?  // Optional description
  analysisType    String   // "plan" | "ml" | "code" | "combined"
  changeRequestId String?  // Associated CR number (optional)
  repoUrl         String?  // For code analysis
  analysisDate    DateTime @default(now())
  
  // Scores
  overallScore    Float?
  planReadyScore  Float?
  mlScore         Float?
  codeRiskScore   Float?
  
  // Full analysis data as JSON
  analysisData    String   // JSON blob with full analysis details
  
  // Metadata
  createdBy       String   // User email who created this
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([changeRequestId])
  @@index([analysisType])
  @@index([createdBy])
}
