# Database
DATABASE_URL="file:./dev.db"

# Authentication (NextAuth.js)
NEXTAUTH_SECRET="your-secret-key-here"
NEXTAUTH_URL="http://localhost:3600"

# Application
NEXT_PUBLIC_APP_NAME="Change & Release Dashboard"
NEXT_PUBLIC_APP_URL=http://localhost:3600

# Feature Flags
NEXT_PUBLIC_ENABLE_ANALYTICS=false
NEXT_PUBLIC_ENABLE_NOTIFICATIONS=false

# Git Repository Analysis (GitHub Enterprise / Gitea)
GIT_USER=your-git-username
GIT_PASSWORD=your-git-password-or-token

# Credential Encryption (set to a 64-char hex string for production)
# ENCRYPTION_KEY=your-64-char-hex-key

# API Configuration (future use)
# API_BASE_URL=https://api.example.com
# API_KEY=your-api-key-here

# Monitoring (future use)
# SENTRY_DSN=
# NEXT_PUBLIC_POSTHOG_KEY=
