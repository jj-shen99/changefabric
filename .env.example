# ─── Database Configuration ────────────────────────────────
# Development (SQLite — file-based, zero setup):
# IMPORTANT: Use "file:./prisma/dev.db" (relative to project root) to avoid path issues
DATABASE_PROVIDER="sqlite"
DATABASE_URL="file:./prisma/dev.db"

# Production (PostgreSQL — recommended for multi-user / high-volume):
# DATABASE_PROVIDER="postgresql"
# DATABASE_URL="postgresql://user:password@localhost:5432/release_change_ai?schema=public"

# Authentication (NextAuth.js)
NEXTAUTH_SECRET="your-secret-key-here"
NEXTAUTH_URL="http://localhost:3600"

# Application
NEXT_PUBLIC_APP_NAME="Change Dashboard"
NEXT_PUBLIC_APP_URL=http://localhost:3600

# Feature Flags
NEXT_PUBLIC_ENABLE_ANALYTICS=false
NEXT_PUBLIC_ENABLE_NOTIFICATIONS=false

# Git Repository Analysis (GitHub / GitHub Enterprise / Gitea)
# GIT_ENTERPRISE_URL=https://github.example.com  # Optional: GitHub Enterprise URL
# GIT_DEFAULT_REPO=https://github.com/owner/repo  # Optional: Default repo for analysis
# GIT_USER=your-git-username
# GIT_PASSWORD=your-git-password-or-token

# Credential Encryption (set to a 64-char hex string for production)
# ENCRYPTION_KEY=your-64-char-hex-key

# ─── LLM-Powered Quality Analysis ──────────────────────────
# Provider: "openai" | "anthropic" | "ollama" | "disabled" (default)
LLM_PROVIDER="disabled"
# OpenAI (GPT-4, GPT-3.5)
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# Anthropic (Claude)
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
# Ollama (local models — no API key needed)
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.2

# ─── Predictive Risk Model (ML) ────────────────────────────
# Enable ML-based risk prediction for change requests
ML_RISK_ENABLED="true"
# Model version (used to track which trained model is active)
ML_MODEL_VERSION="v1.0.0"

# API Configuration (future use)
# API_BASE_URL=https://api.example.com
# API_KEY=your-api-key-here

# ─── ITSM Auto-Sync (Cron) ────────────────────────────────
# Secret for authenticating cron requests (required for auto-sync)
# Generate with: openssl rand -hex 32
# CRON_SECRET=your-cron-secret-here

# Monitoring (future use)
# SENTRY_DSN=
# NEXT_PUBLIC_POSTHOG_KEY=
